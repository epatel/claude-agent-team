# Copy to dev-lab/.env (gitignored) and fill in.
#
# Claude auth is NOT here — log in once on this host with the `claude` CLI and
# the Agent SDK reads the stored ~/.claude credentials. See
# cards/subscription-auth.md.

# GitHub token for pushing branches (see cards/repo-sync.md).
GITHUB_TOKEN=

# Optional overrides
MODEL=claude-opus-4-8

# Extension MCP servers (HTTP+SSE) the agent can use as tools, as name=url pairs.
# Example: EXTENSIONS=macos=http://192.168.1.50:8970/sse
EXTENSIONS=

# Do NOT set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN — they override
# subscription auth and bill the API. The lab refuses to start if either is set.
