# systemd unit for the v2 web console (see cards/deployment.md, cards/web-console.md).
# Copy to /etc/systemd/system/dev-lab-web.service, edit the paths/user, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dev-lab-web
#   journalctl -u dev-lab-web -f      # follow logs
#
# Binds loopback only — expose it through a TLS-terminating reverse proxy
# (e.g. Apache; see deploy/apache-dev-lab.conf for a /dev-lab/ path-prefix setup).

[Unit]
Description=claude-agent-team dev lab web console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# MUST be the user that ran `claude` login — subscription credentials live in
# that user's ~/.claude (see cards/subscription-auth.md).
User=epatel
WorkingDirectory=/home/epatel/dev-lab/claude-agent-team
# Optional overrides only (MODEL, CLIENT_TOKEN); chmod 600. GitHub auth is per
# project (stored in the runtime DB, entered in the web console); Claude auth is
# the `claude` login. Do NOT put ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN here —
# they override subscription auth and bill the API.
EnvironmentFile=/home/epatel/dev-lab/claude-agent-team/dev-lab/.env
# The Agent SDK shells out to the `claude` CLI — make sure the user-local
# install location is on the service PATH (systemd's default omits ~/.local/bin).
Environment=PATH=/home/epatel/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/epatel/dev-lab/claude-agent-team/dev-lab/.venv/bin/dev-lab web \
  --labs-dir /home/epatel/dev-lab/labs \
  --host 127.0.0.1 \
  --port 8770
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
