# Copy to dev-lab/.env (gitignored) and fill in.
#
# Claude auth is NOT here — log in once on this host with the `claude` CLI and
# the Agent SDK reads the stored ~/.claude credentials. See
# cards/subscription-auth.md.

# GitHub auth is per project, not here: enter each project's token in the web
# console when you add it (or leave it blank for a public repo). See
# cards/repo-sync.md.

# Optional overrides
MODEL=claude-opus-4-8

# Shared secret platform clients must present when dialing /ws/client
# (cards/extension-clients.md). Leave empty on a trusted LAN; pass the same
# value to `platform-client connect --token ...` when set.
CLIENT_TOKEN=

# Legacy extension MCP servers (HTTP+SSE), as name=url pairs — superseded by
# platform clients dialing in; kept while macos-build-test is unported.
# Example: EXTENSIONS=macos=http://192.168.1.50:8970/sse
EXTENSIONS=

# Do NOT set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN — they override
# subscription auth and bill the API. The lab refuses to start if either is set.
